<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SteamlessController.Driver</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HidSharp" Version="2.6.4"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
      <Reference Include="HIDMaestro.Core">
        <HintPath>libs\HIDMaestro.Core.dll</HintPath>
      </Reference>
    </ItemGroup>
</Project>
